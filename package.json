{
  "name": "gw_sniper",
  "version": "0.0.1",
  "private": true,
  "description": "Self-hosted ShopGoodwill auction tracker + sniper.",
  "packageManager": "pnpm@10.5.0",
  "scripts": {
    "dev:backend": "pnpm --filter @gw_sniper/backend dev",
    "dev:frontend": "pnpm --filter @gw_sniper/frontend dev",
    "build:client": "pnpm --filter shopgoodwill-client build",
    "build:backend": "pnpm --filter @gw_sniper/backend build",
    "build:frontend": "pnpm --filter @gw_sniper/frontend build",
    "build": "pnpm build:client && pnpm build:backend && pnpm build:frontend",
    "db:generate": "pnpm --filter @gw_sniper/backend db:generate",
    "db:migrate": "pnpm --filter @gw_sniper/backend db:migrate",
    "port:kill": "f() { lsof -t -i:\"$1\" | xargs kill -9; }; f",
    "prod": "pnpm --filter @gw_sniper/backend db:migrate && pnpm --filter @gw_sniper/backend start",
    "typecheck": "pnpm -r typecheck"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild"
    ]
  }
}
