{
  "name": "shopgoodwill-client",
  "version": "0.1.0",
  "description": "Unofficial TypeScript client for the shopgoodwill.com buyer API.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist", "src"],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsc -p tsconfig.test.json && node --test 'dist-test/test/*.test.js'",
    "test:integration": "tsc -p tsconfig.test.json && RUN_INTEGRATION=1 node --test 'dist-test/test/integration/*.test.js'",
    "test:watch": "tsc -p tsconfig.test.json --watch & node --test --watch 'dist-test/test/*.test.js'",
    "probe:login": "node --env-file-if-exists=.env --env-file-if-exists=../../.env scripts/probe-login.mjs"
  },
  "keywords": ["shopgoodwill", "goodwill", "auction", "client", "api"],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.11.0",
    "typescript": "^5.4.0"
  },
  "packageManager": "pnpm@10.5.0"
}
