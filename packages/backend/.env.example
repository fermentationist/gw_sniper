# Path to SQLite database file (relative to backend package or absolute).
DATABASE_URL=./data/gw-sniper.db

# 32+ char random string. Used to derive AES key for password encryption
# AND to sign the auth session cookie. Rotating this invalidates all stored
# secrets and existing sessions.
APP_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# Password required to log into the GW-Sniper dashboard.
APP_PASSWORD=change-me

# HTTP port for the backend.
PORT=3001

# Set to 'production' to enable Secure cookies (requires HTTPS).
NODE_ENV=development
